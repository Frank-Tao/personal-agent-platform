<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.franktao.pap.work-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-c</string>
    <string>set -a; [ -f "__REPO__/infra/env" ] &amp;&amp; . "__REPO__/infra/env"; set +a; export PATH="__HOME__/.local/bin:/opt/homebrew/bin:$PATH"; "__NODE__" "__REPO__/work/cli.ts" advance --apply; "__NODE__" "__REPO__/work/cli.ts" nudge --apply; "__NODE__" "__REPO__/work/cli.ts" watch --apply; "__NODE__" "__REPO__/work/cli.ts" outbox run --apply</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><false/>
  <key>StartInterval</key><integer>600</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/pap/work-watch.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/pap/work-watch.error.log</string>
</dict>
</plist>
