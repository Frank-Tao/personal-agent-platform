<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.franktao.pap.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-c</string>
    <string>set -a; [ -f "__REPO__/infra/env" ] &amp;&amp; . "__REPO__/infra/env"; set +a; export PATH="__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"; exec "__REPO__/infra/bin/backup.sh"</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>RunAtLoad</key><false/>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/pap/backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/pap/backup.error.log</string>
</dict>
</plist>
