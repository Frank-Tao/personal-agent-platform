# Copy to infra/env (gitignored) and fill in. Sourced by the launchd wrappers.
# Hermes CLI and home (defaults: ~/.local/bin/hermes, ~/.hermes). Use absolute paths — no ~ here.
# HERMES_BIN=/Users/you/.local/bin/hermes
# HERMES_HOME=/Users/you/.hermes
# Section layout (boards / cron jobs → Work, Investments, Research, Family, Personal)
# COCKPIT_LAYOUT=config/cockpit.json

COCKPIT_PORT=3200
COCKPIT_HOST=127.0.0.1
COCKPIT_REFRESH_SECONDS=120

# Private pipeline (local LLM only). qwen3.8:27b ~17GB, loaded only while processing (keep_alive 30s); gemma3:12b ~8GB is the lighter fallback.
PRIVATE_MODEL=qwen3.8:27b
OLLAMA_URL=http://127.0.0.1:11434
NEXT_ESTIMATED_TAX_DUE=

# Chat with Atlas from Cockpit: the Hermes API server's key (API_SERVER_KEY in ~/.hermes/.env). If unset, Cockpit reads
# that single line itself; it is only ever used server-side and never sent to a browser.
# HERMES_API_KEY=
# HERMES_API_URL=http://127.0.0.1:8642
# Optional shared secret for writes (chat, new tasks); the page asks for it once.
# COCKPIT_TOKEN=

# Weekly feedback digest (launchd, Mondays 08:30). Dry run until FEEDBACK_WEEKLY=1. The line goes only to this one chat.
# FEEDBACK_WEEKLY=1
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
