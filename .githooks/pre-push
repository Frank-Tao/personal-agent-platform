#!/usr/bin/env bash
# Runs before every push: type check and tests. Enable once per clone: git config core.hooksPath .githooks
# Skip in an emergency with: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
[ -d node_modules ] || { echo "pre-push: run npm install first (TypeScript is needed for the type check)"; exit 1; }
npm run --silent check
npm test --silent 2>&1 | tail -8
