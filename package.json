{
  "name": "personal-agent-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "hq": "node --env-file-if-exists=infra/env apps/portfolio-hq/src/server.ts",
    "hq:demo": "HQ_DEMO=1 node apps/portfolio-hq/src/server.ts",
    "pipeline": "node --env-file-if-exists=infra/env apps/private-pipeline/src/run.ts",
    "pipeline:once": "node --env-file-if-exists=infra/env apps/private-pipeline/src/run.ts --once",
    "test": "node --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\""
  }
}
